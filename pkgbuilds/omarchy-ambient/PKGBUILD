pkgname=omarchy-ambient
pkgver=0.2.0
pkgrel=1
pkgdesc="Live backgrounds and screensavers for Omarchy: programs drawing behind the windows or over everything"
arch=('x86_64' 'aarch64')
url="https://github.com/avillagran/omarchy-ambient"
license=('MIT')
depends=('glibc' 'bash' 'jq' 'socat' 'inotify-tools' 'hyprland' 'wayland' 'libnotify' 'util-linux' 'omarchy-ttfx-layer')
makedepends=('wayland-protocols' 'pkgconf')
optdepends=(
  'fs-uae: the Amiga Demos source'
  'curl: downloading the Amiga demos'
  'libarchive: unpacking the Amiga demos'
  'kitty: the Terminal Effects source'
  'ghostty: the Terminal Effects source'
)
options=('!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('30d99dbd244913bd292a03fa1ace911d7bbcdbdeaea86eb9062743f74be67048')

build() {
  cd "$pkgname-$pkgver"

  make
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
